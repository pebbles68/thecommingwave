{
  // Cloudflare (Workers con recursos estáticos): sirve la carpeta dist/ que genera `npm run build`.
  // Cloudflare ejecuta el build y después `npx wrangler deploy`, que lee este archivo.
  "name": "thecommingwave",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": true,
  "preview_urls": false
}
