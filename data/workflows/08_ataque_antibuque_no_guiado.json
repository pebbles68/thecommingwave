        {
          "id": "aa_high_total",
          "type": "number",
          "appliesTo": "final_interception",
          "prompt": "Valor AA total de los buques con consumo alto."
        }
      ],
      "parallelGroups": [
        [
          "aa_low_total",
          "aa_high_total"
        ]
      ],
      "formula": "Resolver por tipo de consumo y sumar los impactos de Alto Consumo + Bajo Consumo.",
