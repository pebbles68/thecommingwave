            {
              "value": "yes",
              "label": "Sí",
              "effects": [
                {
                  "type": "modifier",
                  "target": "munition_interception_roll",
                  "value": -3
                }
              ]
            },
            {
              "value": "no",
              "label": "No",
              "effects": [
                {
                  "type": "modifier",
                  "target": "munition_interception_roll",
                  "value": 0
