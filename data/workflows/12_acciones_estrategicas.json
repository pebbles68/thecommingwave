{
  "sourceXml": "data/sources/tcw_attack_workflows/12_acciones_estrategicas.xml",
  "iconCatalogRef": "data/sources/tcw_attack_workflows/index.xml#assets/icons",
  "id": "strategic_actions",
  "title": "Acciones estratégicas de ataque",
  "category": "estrategico",
  "source": {
    "sourceId": "tablas-combate",
