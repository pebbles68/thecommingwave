        "columnScheme": "persecucion_ataque"
      },
      {
        "lightPlan": false,
        "pursuit": true,
        "label": "Persecución (plan no ligero, munición Persecución)",
        "columnScheme": "persecucion_objetivo"
      }
    ],
    "rollRowScheme": {
      "mobile": "movil",
      "fixed": "fijo"
    },
    "nineCancelsModifiers": true,
    "resolutionStatus": "Confirmado por el mantenedor (2026-10-05): 4 combinaciones (Ligero/no ligero × Normal/Persecución); el tipo de objetivo (Móvil/Fijo) y la tirada dan la fila. La lectura de la celda combinada de etiquetas la comprobó el análisis de la página a 300 DPI.",
    "sourceRefs": [
