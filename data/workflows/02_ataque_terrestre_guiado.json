  "rollDependentRules": [
    {
      "stage": "attack_intensity",
      "condition": "finalRoll == 9",
      "effect": "cancel_intensity_modifiers",
      "sourceText": "En la tirada de resolución, un 9 cancela las modificaciones de intensidad."
    }
  ],
  "finalTableReference": "Páginas 5-6: Ataque de precisión contra objetivos terrestres y aplicación de efectos.",
  "finalResolution": {
    "note": "Resolución final del Ataque Terrestre Guiado (§5.12.10, página 5): hay UNA cuadrícula de impactos y lo que cambia según el método es qué fila de etiquetas traduce el Valor de Ataque a columna. Dos tipos de ataque (Ligero [L] o no ligero) por dos tipos de munición (Normal o Persecución, la munición con el icono junto a \"Persecución\") dan 4 combinaciones. La fila de etiquetas \"0.5, 1, ·, 2…\" es una celda combinada que sirve a \"[L] Persecución\" y a \"Normal\". La fila de la cuadrícula la da la tirada de 1d10 según el objetivo sea Móvil o Fijo.",
    "table": {
      "file": "page-05.json",
      "id": "ground-precision-attack-damage"
    },
    "valueCap": 13,
    "methodRows": [
      {
        "lightPlan": true,
        "pursuit": false,
        "label": "[L] Normal (plan Ligero, munición Normal)",
        "columnScheme": "normal_ataque"
      },
      {
        "lightPlan": true,
        "pursuit": true,
        "label": "[L] Persecución (plan Ligero, munición Persecución)",
        "columnScheme": "persecucion_ataque"
      },
      {
        "lightPlan": false,
