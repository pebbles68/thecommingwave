<?xml version="1.0" encoding="utf-8"?>
<attackWorkflow id="antiship_guided" title="Ataque antibuque guiado" category="superficie" language="es" version="1.0">
  
  
  <source>
    
    
    <document>TCW - TABLAS DE COMBATE</document>
    
    
    <pages>19-22</pages>
    
  
  </source>
  
  
  <summary>Flujo completo de defensa aérea, interceptación, V.E.F., multiplicador y método de resolución.</summary>
  
  
  <iconCatalog>
    <icon id="munition_unguided" src="icons/munition_unguided.png" alt="Munición no guiada" source="Tipos de munición"/>
    <icon id="munition_subsonic" src="icons/munition_subsonic.png" alt="Munición subsónica" source="Tipos de munición"/>
    <icon id="munition_supersonic" src="icons/munition_supersonic.png" alt="Munición supersónica" source="Tipos de munición"/>
    <icon id="munition_parabolic" src="icons/munition_parabolic.png" alt="Trayectoria parabólica" source="Tipos de munición"/>
    <icon id="munition_near_space" src="icons/munition_near_space.png" alt="Trayectoria de espacio cercano" source="Tipos de munición"/>
    <icon id="munition_light" src="icons/munition_light.png" alt="Munición ligera" source="Tipos de munición"/>
    <icon id="attack_high_penetration" src="icons/attack_high_penetration.png" alt="Alta penetración" source="Plan de ataque - leyenda"/>
    <icon id="attack_ballistic" src="icons/attack_ballistic.png" alt="Ataque balístico" source="Plan de ataque - leyenda"/>
    <icon id="attack_low_altitude_bombing" src="icons/attack_low_altitude_bombing.png" alt="Bombardeo a baja altura" source="Plan de ataque - leyenda"/>
    <icon id="attack_low_altitude_counterattack" src="icons/attack_low_altitude_counterattack.png" alt="Contraataque a baja altura" source="Plan de ataque - leyenda"/>
    <icon id="attack_anti_radiation" src="icons/attack_anti_radiation.png" alt="Ataque antirradiación (ARM)" source="Plan de ataque - leyenda"/>
    <icon id="attack_reinforced_installation" src="icons/attack_reinforced_installation.png" alt="Ataque reforzado a instalaciones" source="Plan de ataque - leyenda"/>
    <icon id="marker_cruise_missile" src="icons/marker_cruise_missile.png" alt="Misil de crucero (CM)" source="Plan de ataque - leyenda"/>
    <icon id="marker_low_flight_cruise_missile" src="icons/marker_low_flight_cruise_missile.png" alt="Misil de crucero de baja firma (LF-CM)" source="Plan de ataque - leyenda"/>
    <icon id="marker_supersonic_cruise_missile" src="icons/marker_supersonic_cruise_missile.png" alt="Misil de crucero supersónico (SUP.CM)" source="Plan de ataque - leyenda"/>
  </iconCatalog>
  <representativeIcons>
    <iconRef ref="marker_cruise_missile"/>
  </representativeIcons>
  <workflow>
    
    
    <stage id="area_air_defense" order="1" title="Defensa aérea de área">
      
      
      <questions>
        
        
        <question id="attacker_detected" type="boolean" appliesTo="area_air_defense_roll">
          
          
          <prompt>¿El atacante ha sido detectado por el defensor?</prompt>
          
          
          <options>
            
            
            <option value="yes" label="Sí">
              
              
              <effect type="modifier" target="area_air_defense_roll" value="0"/>
              
            
            </option>
            
            
            <option value="no" label="No">
              
              
              <effect type="modifier" target="area_air_defense_roll" value="-2"/>
              
            
            </option>
            
          
          </options>
          
        
        </question>
        
        
        <question id="near_space_trajectory" type="boolean" appliesTo="area_air_defense_roll">
          
          
          <prompt>¿La munición usa trayectoria de espacio cercano?</prompt>
          
          
          <options>
            
            
            <option value="yes" label="Sí">
              
              
              <effect type="modifier" target="area_air_defense_roll" value="-3"/>
              
            
            </option>
            
            
            <option value="no" label="No">
              
              
              <effect type="modifier" target="area_air_defense_roll" value="0"/>
              
            
            </option>
            
          
          </options>
          
        
          <iconRef ref="munition_near_space" role="representative"/>
        </question>
        
      
      </questions>
      
      
      <tableReference>Página 19: Defensa aérea de área.</tableReference>
      
    
      <iconRef ref="marker_cruise_missile" role="munition_marker"/>
    </stage>
    
    
    <stage id="munition_interception" order="2" title="Interceptación de munición">
      
      
      <questions>
        
        
        <question id="same_hex_or_central_zone" type="boolean" appliesTo="munition_interception">
          
          
          <prompt>¿Objetivo y atacante están en el mismo hex o Zona Central?</prompt>
          
          
          <options>
            
            
            <option value="yes" label="Sí">
              
              
              <effect type="rule" target="munition_interception" value="no_interception"/>
              
            
            </option>
            
            
            <option value="no" label="No"/>
            
          
          </options>
          
        
        </question>
        
        
        <question id="interception_performance" type="select" appliesTo="munition_interception_roll">
          
          
          <prompt>Rendimiento del sistema que intercepta.</prompt>
          
          
          <options>
            
            
            <option value="high" label="Alto">
              
              
              <effect type="modifier" target="munition_interception_roll" value="0"/>
              
            
            </option>
            
            
            <option value="medium" label="Medio">
              
              
              <effect type="modifier" target="munition_interception_roll" value="-1"/>
              
            
            </option>
            
            
            <option value="low" label="Bajo">
              
              
              <effect type="modifier" target="munition_interception_roll" value="-2"/>
              
            
            </option>
            
          
          </options>
          
        
        </question>
        
        
        <question id="detection_state" type="select" appliesTo="munition_interception_roll">
          
          
          <prompt>¿Qué ha detectado el defensor?</prompt>
          
          
          <options>
            
            
            <option value="attacker" label="Atacante detectado">
              
              
              <effect type="modifier" target="munition_interception_roll" value="0"/>
              
            
            </option>
            
            
            <option value="designator_only" label="No atacante, sí guía/designador">
              
              
              <effect type="modifier" target="munition_interception_roll" value="-1"/>
              
            
            </option>
            
            
            <option value="neither" label="Ni atacante ni guía/designador">
              
              
              <effect type="modifier" target="munition_interception_roll" value="-2"/>
              
            
            </option>
            
          
          </options>
          
        
        </question>
        
        
        <question id="short_range_restriction" type="boolean" appliesTo="munition_interception">
          
          
          <prompt>¿La distancia de ataque es 1 (o 2 en Misión de Área)?</prompt>
          
          
          <options>
            
            
            <option value="yes" label="Sí">
              
              
              <effect type="rule" target="munition_interception" value="only_same_hex_defenders"/>
              
            
            </option>
            
            
            <option value="no" label="No"/>
            
          
          </options>
          
        
        </question>
        
      
      </questions>
      
      
      <tableReference>Página 20: Interceptación de Munición.</tableReference>
      
    
      <iconRef ref="marker_cruise_missile" role="munition_marker"/>
    </stage>
    
    
    <stage id="fleet_electronic_resistance" order="3" title="Resistencia electrónica de la flota">
      
      
      <questions>
        
        
        <question id="attack_distance" type="select" appliesTo="vef_modifier">
          
          
          <prompt>Distancia de ataque / equivalente de Misión de Área.</prompt>
          
          
          <options>
            
            
            <option value="0_2" label="0-2 / Área 0-3">
              
              
              <effect type="modifier" target="vef_modifier" value="0"/>
              
            
            </option>
            
            
            <option value="3_5" label="3-5 / Área 4-6">
              
              
              <effect type="modifier" target="vef_modifier" value="1"/>
              
            
            </option>
            
            
            <option value="6plus" label="6+ / Área 7+">
              
              
              <effect type="modifier" target="vef_modifier" value="3"/>
              
            
            </option>
            
          
          </options>
          
        
        </question>
        
        
        <question id="detection_state" type="select" appliesTo="vef_modifier">
          
          
          <prompt>Estado de detección del atacante y guía/designador.</prompt>
          
          
          <options>
            
            
            <option value="attacker_detected" label="Atacante detectado">
              
              
              <effect type="modifier" target="vef_modifier" value="0"/>
              
            
            </option>
            
            
            <option value="designator_only" label="Atacante no detectado, guía sí">
              
              
              <effect type="modifier" target="vef_modifier" value="-1"/>
              
            
            </option>
            
            
            <option value="neither" label="Ni atacante ni guía detectados">
              
              
              <effect type="modifier" target="vef_modifier" value="-3"/>
              
            
            </option>
            
          
          </options>
          
        
        </question>
        
        
        <question id="highest_fleet_electronic" type="number" appliesTo="vef">
          
          
          <prompt>Valor Electrónico más alto de la flota.</prompt>
          
        
        </question>
        
      
      </questions>
      
      
      <formula>V.E.F. = mayor Valor Electrónico de la flota + modificadores. Aplicar la tabla Mod. V.E.F. y luego el multiplicador del ataque.</formula>
      
      
      <tableReference>Página 21: Resistencia electrónica de buques.</tableReference>
      
    
    </stage>
    
    
    <stage id="attack_method" order="4" title="Método de ataque y tirada">
      
      
      <questions>
        
        
        <question id="method" type="select" appliesTo="attack_resolution">
          
          
          <prompt>Método de ataque.</prompt>
          
          
          <options>
            
            
            <option value="subsonic" label="Subsónico">
              
              
              <effect type="dice" target="attack_resolution" value="roll_2d10_take_highest"/>
              
            
              <iconRef ref="munition_subsonic" role="representative"/>
            </option>
            
            
            <option value="supersonic" label="Supersónico">
              
              
              <effect type="dice" target="attack_resolution" value="roll_1d10"/>
              
            
              <iconRef ref="munition_supersonic" role="representative"/>
            </option>
            
            
            <option value="ballistic" label="Trayectoria balística">
              
              
              <effect type="dice" target="attack_resolution" value="roll_1d10"/>
              
            
              <iconRef ref="attack_ballistic" role="representative"/>
            </option>
            
            
            <option value="near_space" label="Trayectoria de espacio cercano">
              
              
              <effect type="dice" target="attack_resolution" value="roll_1d10"/>
              
            
              <iconRef ref="munition_near_space" role="representative"/>
            </option>
            
          
          </options>
          
        
        </question>
        
      
      </questions>
      
      
      <tableReference>Páginas 21-22: Ataque guiado contra buques de superficie.</tableReference>
      
    
    </stage>
    
  
  </workflow>
  
  
  <finalTableReference>Página 22: tabla de Ataque Guiado contra Buques de Superficie.</finalTableReference>
  

</attackWorkflow>
